{%- comment -%} Footer: guarantee strip, link columns, payment badges. {%- endcomment -%}
<div class="container-x">
  <div class="guarantee">
    <div>{% render 'icon', name: 'shield' %} Govt. lab certified</div>
    <div>{% render 'icon', name: 'sparkle' %} Energised before dispatch</div>
    <div>{% render 'icon', name: 'truck' %} Free prepaid shipping</div>
    <div>{% render 'icon', name: 'return' %} 7-day easy returns</div>
  </div>
</div>
<footer class="footer">
  <div class="container-x">
    <div class="footer__cols">
      <div>
        <h3>{{ shop.name }}</h3>
        <p style="font-size:.83rem;max-width:38ch">{{ section.settings.about }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ shop.enabled_payment_types | payment_type_svg_tag }}</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [ { "type": "textarea", "id": "about", "label": "About text", "default": "Original, government-certified spiritual products — energised by our astrologers and shipped across India." } ],
  "blocks": [ { "type": "column", "name": "Link column", "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "link_list", "id": "menu", "label": "Menu" } ] } ]
}
{% endschema %}
