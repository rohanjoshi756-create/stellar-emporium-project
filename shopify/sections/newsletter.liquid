{%- comment -%} Newsletter lead capture. Field name: contact[email]. {%- endcomment -%}
<section class="section newsletter cv-auto" aria-label="Newsletter signup">
  <div class="container-x">
    <h2 class="font-display">{{ section.settings.title }}</h2>
    <p style="opacity:.78;font-size:.88rem;margin:.5rem 0 0">{{ section.settings.subtitle }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com">
      <button type="submit" class="btn btn-gold">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}<p style="width:100%;font-size:.8rem">Thanks — you're on the list.</p>{%- endif -%}
    {% endform %}
    <p style="opacity:.6;font-size:.7rem;margin-top:.6rem">No spam. Unsubscribe in one click.</p>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Join the Nakshatra circle" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "New launches, festival drops and astrologer tips." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
