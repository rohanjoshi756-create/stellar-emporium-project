{%- comment -%}
  Reusable Shopify article card.
  Required: card_article
  Optional: featured
{%- endcomment -%}
{%- liquid
  assign reading_words = card_article.content | strip_html | split: ' ' | size
  assign reading_minutes = reading_words | divided_by: 200
  if reading_minutes < 1
    assign reading_minutes = 1
  endif
-%}
<article class="journal-card{% if featured %} journal-card--featured{% endif %}">
  <a class="journal-card__media" href="{{ card_article.url }}" aria-label="Read {{ card_article.title | escape }}">
    {%- if card_article.image != blank -%}
      {{ card_article.image | image_url: width: 1600 | image_tag:
        widths: '360, 540, 720, 960, 1200, 1600',
        sizes: '(min-width: 990px) 50vw, 100vw',
        loading: 'lazy',
        alt: card_article.image.alt | default: card_article.title
      }}
    {%- else -%}
      <span class="journal-card__placeholder" aria-hidden="true">{{ shop.name }}</span>
    {%- endif -%}
  </a>
  <div class="journal-card__body">
    <div class="journal-card__meta">
      <span>{{ card_article.tags.first | default: card_article.blog.title }}</span>
      <span aria-hidden="true">·</span>
      <span>{{ reading_minutes }} min read</span>
    </div>
    <h2 class="journal-card__title"><a href="{{ card_article.url }}">{{ card_article.title }}</a></h2>
    <p class="journal-card__excerpt">{{ card_article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
    <div class="journal-card__foot">
      <time datetime="{{ card_article.published_at | date: '%Y-%m-%d' }}">{{ card_article.published_at | date: '%d %B %Y' }}</time>
      <a class="journal-card__read" href="{{ card_article.url }}">Read article <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>