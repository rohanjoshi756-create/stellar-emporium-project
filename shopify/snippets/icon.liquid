{%- comment -%}
  Inline SVG icon set. Usage: {% render 'icon', name: 'cart' %}
  Keeps the theme free of icon-font requests.
{%- endcomment -%}
{%- case name -%}
  {%- when 'cart' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.4 12h11l2-8H6"/></svg>
  {%- when 'search' -%}
