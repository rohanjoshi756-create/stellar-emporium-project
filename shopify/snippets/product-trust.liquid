{%- comment -%}
  product-trust.liquid — offers box, trust badge grid and delivery promise.
  Pure presentation; copy is editable from theme settings.
{%- endcomment -%}
<div class="offers">
  <h2>Available offers</h2>
  <ul>
    <li>Free shipping on all prepaid orders across India</li>
    <li>Complimentary energisation with Vedic mantras before dispatch</li>
    <li>Government lab authenticity certificate included in every parcel</li>
  </ul>
</div>

<ul class="trust-grid">
  <li>{% render 'icon', name: 'shield' %} Govt. lab certified</li>
  <li>{% render 'icon', name: 'sparkle' %} Energised by astrologers</li>
  <li>{% render 'icon', name: 'truck' %} Free prepaid shipping</li>
  <li>{% render 'icon', name: 'return' %} 7-day easy returns</li>
</ul>

<ul class="delivery">
  <li>Dispatch within 24 hours</li>
  <li>Delivery in 3–5 working days</li>
  <li>COD available</li>
</ul>